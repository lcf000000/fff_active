# 复制为 .env 并填写（.env 已在 .gitignore 中，绝不要提交）

# ---- 标准码（Ed25519，86 字符，防伪造，推荐）----
# Ed25519 私钥种子：64 位十六进制（32 字节）。只放在这台服务器，APK 里只放对应的公钥。
# 生成： python3 -c "import secrets;print(secrets.token_hex(32))"
# 取公钥（给 APK 构建用）： docker compose run --rm fff-active python -m fffactive.cli --pubkey
FFF_ACTIVE_ED_SEED=

# ---- 紧凑码（HMAC，20 字符，可选）----
# 64 位十六进制。和 APK 构建时（-PfffActiveMode=mac 或 both）用的是同一个值。
# 不需要紧凑码就留空：此时网页里不显示该选项。注意：紧凑码的密钥会被编进 APK，可被逆向提取。
FFF_ACTIVE_SECRET=

# ---- 网页登录（HTTP Basic）。至少 8 位，不能用 change-me ----
ADMIN_USER=admin
ADMIN_PASSWORD=
